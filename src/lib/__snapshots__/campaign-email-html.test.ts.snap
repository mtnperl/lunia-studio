      </div>
      
    </td></tr><tr><td class="h-padding" style="padding:0 24px 16px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed;">
        <tr><td class="secondary-cell" width="48.91%" style="width:48.91%;vertical-align:middle;"><img src="data:image/svg+xml;base64," width="270" style="display:block;width:100%;height:auto;border-radius:8px;" alt=""></td><td class="secondary-spacer" width="12" style="width:12px;font-size:0;">&nbsp;</td><td class="secondary-cell" width="48.91%" style="width:48.91%;vertical-align:middle;"><p style="margin:0 0 16px;color:#ffffff;font-size:18.7px;font-weight:300;font-family:Inter,Arial,Helvetica,sans-serif;line-height:1.6;text-align:left;">Copy beside the image, which stacks to full width on mobile.</p></td></tr>
      </table>
    </td></tr>
      <tr><td class="h-padding" style="padding:0 24px 24px;" align="center">
    <a class="cta-link" href="https://www.lunialife.com" target="_blank" style="text-decoration:none;display:block;max-width:300px;">
